# Copy to .env (git-ignored). Never commit real keys.
FIVEU_API_KEY=hk_...
FIVEU_BASE_URL=https://api.start-hack.5u.ai
# Your own OpenAI key is posted once to the gateway, not used directly:
# POST $FIVEU_BASE_URL/v1/gateway/openai-key  {"api_key": "sk-..."}
# Then use $FIVEU_BASE_URL/v1/gateway as the OpenAI base_url with FIVEU_API_KEY as api_key.
