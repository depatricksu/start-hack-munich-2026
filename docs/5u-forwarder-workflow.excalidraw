   "locked": false
  },
  {
   "id": "ed7971506",
   "type": "text",
   "x": 926,
   "y": 502.5,
   "width": 908,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1341532702,
   "version": 1,
   "versionNonce": 524285384,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Score per accepted quote (within 5% of best price), max 100:\nPRICE 45 (best price)  ·  LLM COST 40 (full at $0, zero at $0.10)  ·  SPEED 15 (full <2 min, zero 6 min)\nBonus +10 correct tracking answer · +10 most human email · carrier bids: price/speed 50/50\nFinal: 3-min pitch + jury (pitch, UX/design, codebase, human emails)",
   "originalText": "Score per accepted quote (within 5% of best price), max 100:\nPRICE 45 (best price)  ·  LLM COST 40 (full at $0, zero at $0.10)  ·  SPEED 15 (full <2 min, zero 6 min)\nBonus +10 correct tracking answer · +10 most human email · carrier bids: price/speed 50/50\nFinal: 3-min pitch + jury (pitch, UX/design, codebase, human emails)",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e8b8f5f4b",
   "lineHeight": 1.25,
   "autoResize": true
  },
