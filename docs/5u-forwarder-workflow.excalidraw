  },
  {
   "id": "e21f7b973",
   "type": "text",
   "x": 26,
   "y": 453.75,
   "width": 848,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1779169547,
   "version": 1,
   "versionNonce": 1103669200,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Rules\n• Same request to all teams at the same time · no second chance\n• Only first quote in the customer's thread counts\n• Quote ONE option: cheapest or fastest (what customer asked) · one all-in total + currency\n• Some airlines only in sheets, others only on portal\n• After a few hours setup changes ~hourly, unannounced (you notice via failed quotes)",
   "originalText": "Rules\n• Same request to all teams at the same time · no second chance\n• Only first quote in the customer's thread counts\n• Quote ONE option: cheapest or fastest (what customer asked) · one all-in total + currency\n• Some airlines only in sheets, others only on portal\n• After a few hours setup changes ~hourly, unannounced (you notice via failed quotes)",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e0ee2eee4",
   "lineHeight": 1.25,
   "autoResize": true
  },
