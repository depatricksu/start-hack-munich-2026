   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Deterministic first, LLM only where needed (cost = 40 pts). Must make ≥1 tiny gateway call per quote or lose cost points.",
   "originalText": "Deterministic first, LLM only where needed (cost = 40 pts). Must make ≥1 tiny gateway call per quote or lose cost points.",
