  {
   "id": "e7fa078ab",
   "type": "text",
   "x": 1466,
   "y": 895.0,
   "width": 678,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1329447848,
   "version": 1,
   "versionNonce": 2131074778,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Curveballs\n• A new request every 6 min, all night\n• Airlines email new tariffs anytime → update prices\n• Some airlines only in sheets, others only on portal\n• Setup changes ~every hour, no warning\n  → we only notice from failed quotes\n• Only our FIRST reply in a thread counts",
   "originalText": "Curveballs\n• A new request every 6 min, all night\n• Airlines email new tariffs anytime → update prices\n• Some airlines only in sheets, others only on portal\n• Setup changes ~every hour, no warning\n  → we only notice from failed quotes\n• Only our FIRST reply in a thread counts",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e2e37966f",
   "lineHeight": 1.25,
   "autoResize": true
  },
