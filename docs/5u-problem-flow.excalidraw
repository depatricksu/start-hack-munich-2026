   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Winning = leaderboard + jury\n• 3-min pitch + 2-min Q&A\n• Jury: pitch, UX & design, codebase,\n  how human the emails read\n• Build a sessions UI: watch each request\n  live, step in and fix it by hand",
   "originalText": "Winning = leaderboard + jury\n• 3-min pitch + 2-min Q&A\n• Jury: pitch, UX & design, codebase,\n  how human the emails read\n• Build a sessions UI: watch each request\n  live, step in and fix it by hand",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e62f7b937",
   "lineHeight": 1.25,
   "autoResize": true
  },
