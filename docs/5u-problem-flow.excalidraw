  {
   "id": "e98657de9",
   "type": "text",
   "x": 6,
   "y": 905.0,
   "width": 678,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1515272081,
   "version": 1,
   "versionNonce": 712006824,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What is \"the right price\"?\n• Quote only what was asked: cheapest OR fastest\n• Carrier bids: best balance, price & speed 50/50\n• One all-in total (freight + fees + pickup truck)\n• Must be within 5% of the best price, else 0 pts\n• Rate sheets have traps: best ≠ obvious",
   "originalText": "What is \"the right price\"?\n• Quote only what was asked: cheapest OR fastest\n• Carrier bids: best balance, price & speed 50/50\n• One all-in total (freight + fees + pickup truck)\n• Must be within 5% of the best price, else 0 pts\n• Rate sheets have traps: best ≠ obvious",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e987f704f",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "ed19b9579",
