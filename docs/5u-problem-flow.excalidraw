   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1894671456,
   "version": 1,
   "versionNonce": 2049013511,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How we're scored (per request, max 100)\n• Price accuracy ........ 45\n• LLM cost ................. 40   ($0 = full, $0.10 = zero)\n• Speed ...................... 15   (<2 min full, 6 min zero)\n• Bonus: +10 right tracking answer\n• Bonus: +10 most human email (jury)",
   "originalText": "How we're scored (per request, max 100)\n• Price accuracy ........ 45\n• LLM cost ................. 40   ($0 = full, $0.10 = zero)\n• Speed ...................... 15   (<2 min full, 6 min zero)\n• Bonus: +10 right tracking answer\n• Bonus: +10 most human email (jury)",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "ed19b9579",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
