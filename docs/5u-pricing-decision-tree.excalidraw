  {
   "id": "e8034ab4d",
   "type": "text",
   "x": 46,
   "y": 1411.875,
   "width": 1308,
   "height": 106.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
